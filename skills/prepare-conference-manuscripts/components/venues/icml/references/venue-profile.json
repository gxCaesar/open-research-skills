{
  "schema_version": 1,
  "venue": "ICML 2026",
  "year": 2026,
  "track": "Main Track",
  "checked_on": "2026-09-04",
  "rule_sources": {
    "DOCUMENT_CLASS": ["ICML2026_AUTHOR_INSTRUCTIONS"],
    "ICML26_STYLE_CURRENT": ["ICML2026_AUTHOR_INSTRUCTIONS", "ICML2026_STYLE_ARCHIVE"],
    "ANON_ACKNOWLEDGMENTS": ["ICML2026_AUTHOR_INSTRUCTIONS"],
    "ABSTRACT_REQUIRED": ["ICML2026_AUTHOR_INSTRUCTIONS"],
    "REQUIRED_HEADING": ["ICML2026_AUTHOR_INSTRUCTIONS"],
    "PDF_PAGE_SIZE": ["ICML2026_AUTHOR_INSTRUCTIONS"],
    "PDF_FILE_SIZE": ["ICML2026_AUTHOR_INSTRUCTIONS"],
    "PDF_AUTHOR_METADATA": ["ICML2026_AUTHOR_INSTRUCTIONS"]
  },
  "allowed_stages": [
    "anonymous_submission",
    "supplementary_package",
    "camera_ready"
  ],
  "tex_contract": {
    "document_class": "article",
    "style_package": "icml2026",
    "style_rule_id": "ICML26_STYLE_CURRENT",
    "required_document_class_options": ["letterpaper"],
    "required_options": {
      "camera_ready": ["accepted"]
    },
    "forbidden_options": {
      "anonymous_submission": ["accepted"]
    },
    "anonymous_stages": ["anonymous_submission", "supplementary_package"],
    "anonymous_source_author_mode": "render_hidden",
    "forbid_acknowledgments_in_anonymous": true,
    "final_copy_command": "",
    "required_headings": {
      "anonymous_submission": ["Impact Statement"],
      "camera_ready": ["Impact Statement"]
    },
    "forbidden_layout_packages": ["a4wide", "fullpage", "geometry", "setspace", "savetrees", "titlesec", "typearea"],
    "require_abstract": ["anonymous_submission", "camera_ready"]
  },
  "pdf_contract": {
    "page_width_points": 612.0,
    "page_height_points": 792.0,
    "page_tolerance_points": 2.0,
    "anonymous_stages": ["anonymous_submission", "supplementary_package"],
    "max_total_pages": {},
    "max_file_size_mb": {
      "anonymous_submission": 50,
      "camera_ready": 20
    },
    "manual_content_page_limit": {
      "anonymous_submission": 8,
      "camera_ready": 9
    }
  }
}
